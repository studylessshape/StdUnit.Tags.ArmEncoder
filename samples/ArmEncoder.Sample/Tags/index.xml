<?xml version="1.0" encoding="utf-8"?>
<Project xmlns:arm="tags:ArmEncoder">
	<Channel name="Arm1" driver="ArmEncoder">
		<arm:Port>COM6</arm:Port>
	</Channel>
	<Channel name="Arm2" driver="ArmEncoder">
		<arm:Port>COM8</arm:Port>
	</Channel>

	<Channel name="file" driver="SimpleFiles">
		<BaseDir>.</BaseDir>
	</Channel>

	<TagGrp name="entry" isEntry="true" isEnabled="true">
		<TagGrp name="ArmCommand" channel="file">
			<Tag name="1#" address="Arm1" type="STR" access="R1W" autoCreateFile="true" />
			<Tag name="2#" address="Arm2" type="STR" access="R1W" autoCreateFile="true" />
		</TagGrp>

		<TagGrp name="Arms">
			<Tag name="1#" channel="Arm1" access="RO" type="STR"></Tag>
			<Tag name="2#" channel="Arm2" access="RO" type="BYTES"></Tag>
		</TagGrp>
	</TagGrp>
</Project>