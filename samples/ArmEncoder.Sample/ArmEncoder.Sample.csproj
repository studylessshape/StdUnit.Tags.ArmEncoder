<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<PropertyGroup>
		<StdUnitTagsVersion>2.0.0-dev.261113.1152</StdUnitTagsVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="R3" Version="1.3.1" />
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="StdUnit.Tags" Version="$(StdUnitTagsVersion)" />
		<PackageReference Include="StdUnit.Tags.R3Extensions" Version="2.0.0-dev.261113.1152" />
		<PackageReference Include="StdUnit.Tags.WebUi" Version="$(StdUnitTagsVersion)" />
		<PackageReference Include="StdUnit.Tags.S7" Version="$(StdUnitTagsVersion)" />
		<PackageReference Include="StdUnit.Tags.SimpleFiles" Version="$(StdUnitTagsVersion)" />

		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.29" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\src\StdUnit.Tags.ArmEncoder.csproj" />
	</ItemGroup>


	<ItemGroup>
		<None Update="Tags\index.xml">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</None>
	</ItemGroup>
</Project>
